{
  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "household_name": {
            "title": "Household Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "host"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "household_name"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "BindingOut": {
        "properties": {
          "person_id": {
            "format": "uuid",
            "title": "Person Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "pending"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "status"
        ],
        "title": "BindingOut",
        "type": "object"
      },
      "CsrfOut": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut",
        "type": "object"
      },
      "DeviceOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/PersonOut"
            },
            "title": "People",
            "type": "array"
          }
        },
        "required": [
          "id",
          "people"
        ],
        "title": "DeviceOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "redis": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "database",
          "redis"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "JoinIn": {
        "properties": {
          "device_label": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Label"
          },
          "night_code": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Night Code",
            "type": "string"
          },
          "slug": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "night_code"
        ],
        "title": "JoinIn",
        "type": "object"
      },
      "JoinOut": {
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "household_name": {
            "title": "Household Name",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "household_name",
          "session_id",
          "device_id"
        ],
        "title": "JoinOut",
        "type": "object"
      },
      "MagicLinkIn": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "MagicLinkIn",
        "type": "object"
      },
      "MagicLinkOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "MagicLinkOut",
        "type": "object"
      },
      "PersonOut": {
        "properties": {
          "avatar_emoji": {
            "title": "Avatar Emoji",
            "type": "string"
          },
          "binding": {
            "enum": [
              "mine",
              "pending",
              "taken",
              "free"
            ],
            "title": "Binding",
            "type": "string"
          },
          "color": {
            "title": "Color",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "avatar_emoji",
          "color",
          "is_guest",
          "binding"
        ],
        "title": "PersonOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyIn": {
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Family Night Hub API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/magic-link": {
      "post": {
        "description": "Same answer, and the same work before answering, whether or not the account exists:\nthe email goes out in a background task after the response.",
        "operationId": "request_magic_link_api_v1_auth_magic_link_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MagicLinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many requests for this address"
          }
        },
        "summary": "Request Magic Link",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "operationId": "verify_api_v1_auth_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Link invalid, expired or already used"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/csrf": {
      "get": {
        "description": "Returns the double-submit token, minting the cookie if the browser has none.",
        "operationId": "issue_csrf_api_v1_csrf_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Issue Csrf",
        "tags": [
          "join"
        ]
      }
    },
    "/api/v1/devices/me": {
      "get": {
        "operationId": "my_device_api_v1_devices_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "My Device",
        "tags": [
          "people"
        ]
      }
    },
    "/api/v1/devices/me/people/{person_id}": {
      "delete": {
        "operationId": "unbind_person_api_v1_devices_me_people__person_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Person Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unbind Person",
        "tags": [
          "people"
        ]
      },
      "put": {
        "operationId": "bind_person_api_v1_devices_me_people__person_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "person_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Person Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BindingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such person in this household"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bind Person",
        "tags": [
          "people"
        ]
      }
    },
    "/api/v1/join": {
      "post": {
        "operationId": "join_api_v1_join_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid join"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many failures"
          }
        },
        "summary": "Join",
        "tags": [
          "join"
        ]
      }
    },
    "/api/v1/people": {
      "get": {
        "operationId": "list_people_api_v1_people_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PersonOut"
                  },
                  "title": "Response List People Api V1 People Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List People",
        "tags": [
          "people"
        ]
      }
    }
  }
}
