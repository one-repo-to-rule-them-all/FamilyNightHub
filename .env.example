# Local development. Copy to .env. Every variable is documented in
# docs/architecture/02-environments.md ("Secrets map"); staging/prod use `fly secrets`.
# Compose overrides the DB/Redis hosts for the api container; these values are for running
# uvicorn/pytest on the host against the compose ports.

ENVIRONMENT=development

# App role (no BYPASSRLS) for runtime; owner role for Alembic only.
DATABASE_URL=postgresql+asyncpg://fnh_app:fnh_app@localhost:55432/fnh_dev
MIGRATION_DATABASE_URL=postgresql+psycopg2://fnh:fnh@localhost:55432/fnh_dev
REDIS_URL=redis://localhost:56379/0

SESSION_SECRET=dev-insecure-session-secret
DEVICE_TOKEN_PEPPER=dev-insecure-device-pepper

# Join failure budget per slug (docs/architecture/03-backend.md "Rate limiting").
JOIN_FAILURE_LIMIT=30
JOIN_FAILURE_WINDOW_SECONDS=900

# Host/admin sign-in (magic links). Locally, "smtp" + MailHog (UI on :58025); "log" just logs.
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_MODE=smtp
EMAIL_FROM=Family Night <movie-night@localhost>
SMTP_HOST=localhost
SMTP_PORT=51025
# On Fly: provider SMTP host/port, SMTP_USERNAME, EMAIL_API_KEY (password), SMTP_STARTTLS=true.

# TMDB (server-only). Unset token = search off, typed titles only. Locally: the tmdb-fake
# compose service (any token works); on Fly: the real API and a read token in fly secrets.
TMDB_BASE_URL=http://localhost:58100
TMDB_READ_TOKEN=dev-fake-tmdb-token

# Photos bucket (ADR-0005). Locally the SeaweedFS compose service (dev credentials from
# infra/seaweedfs/s3.json); on Fly, Tigris (https://fly.storage.tigris.dev, region "auto").
# Unset endpoint or keys = photos off (the photo routes answer 503).
# STORAGE_PUBLIC_ENDPOINT: where phones reach the bucket, if the API reaches it elsewhere.
STORAGE_ENDPOINT=http://localhost:58333
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=fnh-photos
STORAGE_ACCESS_KEY_ID=fnh-dev-access
STORAGE_SECRET_ACCESS_KEY=fnh-dev-secret
STORAGE_REGION=us-east-1

CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Frontend (server-only; never NEXT_PUBLIC_): where Next rewrites /api/* to.
API_INTERNAL_URL=http://localhost:8000
